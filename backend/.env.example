# Skopírujte do backend/.env a doplňte hodnoty. Súbor .env sa necommituje (NFR-V2-06).
# supabase = ukladanie do Supabase, memory = pamäťové úložisko pre testy (bez Supabase).
STORAGE=supabase
# Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase dashboard → Project Settings → API → service_role (secret). Nikdy nie do frontend/.
SUPABASE_SERVICE_ROLE_KEY=
